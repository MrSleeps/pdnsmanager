{
    "require": {
        "slim/slim": "^3.12",
        "monolog/monolog": "^2.10",
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Services\\": "services/",
            "Controllers\\": "controllers/",
            "Operations\\": "operations/",
            "Plugins\\": "plugins/",
            "Middlewares\\": "middlewares/",
            "Exceptions\\": "exceptions/",
            "Utils\\": "utils/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "lint": "vendor/bin/php-cs-fixer fix --dry-run --rules @PSR12 --using-cache false --stop-on-violation --diff ./"
    }
}
